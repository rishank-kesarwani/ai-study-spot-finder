# Environment & Access Control
NODE_ENV=development
PORT=4003
FRONTEND_URL=http://localhost:3000
# PUBLIC_ACCESS_ENABLED: When true, allows anonymous browsing on @OptionalAuth() routes.
# When false, @OptionalAuth() routes require valid JWT authentication.
PUBLIC_ACCESS_ENABLED=true

# Security & JWT Secrets (Change in production)
JWT_ACCESS_SECRET=super_secret_jwt_access_key_ai_study_spot_finder_2026_dev
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_ai_study_spot_finder_2026_dev
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_RESET_SECRET=super_secret_pwd_reset_key_ai_study_spot_finder_2026_dev
PASSWORD_RESET_EXPIRATION=1h

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-study-spot-finder

# Redis (Cache & Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# AI Platform Integration (Shared Platform for LLM, Embeddings, RAG & Memory)
AI_PLATFORM_URL=http://localhost:5000
AI_PLATFORM_API_KEY=platform_master_key_dev_12345
AI_PLATFORM_TIMEOUT_MS=60000
APPLICATION_ID=ai-study-spot-finder

# Notification Service Integration (Shared Service for Email, Push & In-App)
NOTIFICATION_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_API_KEY=notification_service_api_key_12345

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AI_LIMIT=20
THROTTLE_AUTH_LIMIT=10
