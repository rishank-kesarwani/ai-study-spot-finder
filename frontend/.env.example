# Frontend Environment & Access Control
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="StudySphere AI"
NEXT_PUBLIC_DEFAULT_CITY="New York"

# NEXT_PUBLIC_ACCESS_ENABLED: Controls client-side free browsing experience.
# When true, unauthenticated users can freely search, filter, and view study spots without modal locks.
# When false, viewing protected/optional flows prompts for authentication upfront.
NEXT_PUBLIC_ACCESS_ENABLED=true
